<Application x:Class="APP.GK.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:APP.GK.WPF.ViewModels"
             xmlns:views="clr-namespace:APP.GK.WPF.Vistas">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Diccionarios básicos de MaterialDesign -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <!-- Diccionario específico para botones (incluye MaterialDesignFlatButton) -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <!-- Opcional: puedes agregar colores primarios y acentos -->

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <!-- Tus DataTemplates -->
            <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
                <views:OrdersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OrderDetailViewModel}">
                <views:OrderDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>

            <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
                <Setter Property="Background" Value="#C63527"/>
                <Setter Property="Margin" Value="0 0 8 0"/>
                <Setter Property="Width" Value="2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Background="{TemplateBinding Background}" 
                                Width="{TemplateBinding Width}"
                                CornerRadius="2"
                                Height="Auto"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
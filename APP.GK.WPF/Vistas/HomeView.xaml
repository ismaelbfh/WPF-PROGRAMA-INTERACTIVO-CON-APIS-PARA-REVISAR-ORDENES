<UserControl x:Class="APP.GK.WPF.Vistas.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White">
    <DockPanel LastChildFill="True">
        <!-- FOOTER -->
        <materialDesign:ColorZone DockPanel.Dock="Bottom" Background="White" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Texto del footer en rojo -->
                <TextBlock Text="© 2025 Goikoa. Todos los derechos reservados."
                           Foreground="#C63527"
                           Style="{DynamicResource MaterialDesignBody2}"
                           VerticalAlignment="Center"
                           Grid.Column="0"/>
                <Image Source="pack://application:,,,/APP.GK.WPF;component/Recursos/GamFamilyIcon.png"
                       Height="40"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Grid.Column="1"/>
            </Grid>
        </materialDesign:ColorZone>

        <!-- CONTENIDO PRINCIPAL -->
        <StackPanel Background="White">
            <!-- CABECERA: Ícono + Título -->
            <Grid Margin="16,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- SECCIÓN: Texto e Imagen principal -->
            <Grid Margin="16,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Imagen principal -->
                <Image Grid.Column="1"
                       Source="pack://application:,,,/APP.GK.WPF;component/Recursos/GoikoaHomeImage.png"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       MaxHeight="400"/>
            </Grid>

            <!-- SECCIÓN DE PRODUCTOS -->
            <StackPanel Margin="16,16,16,0" Orientation="Vertical"/>

            <!-- BOTONES DE ACCESO RÁPIDO -->
            <StackPanel Margin="17,42,24,80" Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Botón: Ir a Listado de Órdenes -->
                <Button Width="103" Height="76" Margin="16,0"
                        Command="{Binding ShowCommandOrders}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#C63527">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/APP.GK.WPF;component/Recursos/ListadoOrdenesIcon.png"
                               Height="37" Width="132" Margin="0,0,0,4"/>
                        <TextBlock Text="Ir Listado"
                                   Style="{DynamicResource MaterialDesignSubtitle1}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Botón: Ir a Cámara Visión -->
                <Button Width="104" Height="76" Margin="16,0"
                        Command="{Binding ShowCommandCamera}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#C63527">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/APP.GK.WPF;component/Recursos/CamaraIcon.png"
                               Height="46" Width="140" Margin="0,0,0,4"/>
                        <TextBlock Text="Ir Cámara"
                                   Style="{DynamicResource MaterialDesignSubtitle1}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Height="16" Width="68"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>

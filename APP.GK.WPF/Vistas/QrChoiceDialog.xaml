<Window x:Class="APP.GK.WPF.Vistas.QrChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Seleccionar QR"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="12"
            Background="White"
            BorderBrush="#C63527"
            BorderThickness="2"
            SnapsToDevicePixels="True">

        <Grid Width="520">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CABECERA ROJA -->
            <Border Grid.Row="0"
                    Background="#C63527"
                    CornerRadius="12,12,0,0"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="SELECCIONAR QR A ENVIAR"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="16"
                               VerticalAlignment="Center"/>

                    <!-- BOTÓN CERRAR (X) -->
                    <Button Grid.Column="1"
                            Width="34" Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Cerrar"
                            Click="Cancelar_Click">
                        <TextBlock Text="✕"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENIDO -->
            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="#C63527" Margin="0,0,12,0">
                        <TextBlock Text="?"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel>
                        <TextBlock Text="¿Qué QR quieres enviar a la cámara?"
                                   Foreground="#C63527"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Selecciona el QR de la tapa superior o inferior."
                                   Foreground="Gray"
                                   FontSize="13"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- BOTONES PRINCIPALES -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Height="58"
                            Background="#C63527"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="QrArriba_Click">
                        <Border CornerRadius="10" Background="#C63527" Padding="12,8" Height="58" Width="113">
                            <StackPanel>
                                <TextBlock Text="QR ARRIBA"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Tapa superior"
                                           FontSize="12"
                                           Opacity="0.9"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Grid.Column="2"
                            Height="58"
                            Background="#C63527"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="QrAbajo_Click">
                        <Border CornerRadius="10" Background="#C63527" Padding="12,8" Height="58" Width="111">
                            <StackPanel>
                                <TextBlock Text="QR ABAJO"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Tapa inferior"
                                           FontSize="12"
                                           Opacity="0.9"
                                           HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>

                <!-- CANCELAR -->
                <Button Grid.Row="2"
                        Height="44"
                        Background="White"
                        Foreground="#C63527"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderBrush="#C63527"
                        BorderThickness="2"
                        Cursor="Hand"
                        Click="Cancelar_Click">
                    <Border CornerRadius="10" Background="White" Padding="12,6">
                        <TextBlock Text="CANCELAR"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="APP.GK.WPF.CustomComponents.CustomMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Caption}" 
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MinWidth="300"
        MinHeight="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <!-- Se define el borde negro para toda la ventana -->
    <Border BorderBrush="#C63527" BorderThickness="2" CornerRadius="5" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Encabezado personalizado -->
                <RowDefinition Height="Auto"/>
                <!-- Área de contenido -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado con botón de cierre -->
            <DockPanel Grid.Row="0" Background="#C63527" Height="50" LastChildFill="False">
                <!-- Título -->
                <TextBlock Text="{Binding Caption}" 
                           VerticalAlignment="Center" 
                           Margin="10,0,0,0"
                           FontSize="18" 
                           FontWeight="Bold"
                           Foreground="White"
                           DockPanel.Dock="Left"/>
                <!-- Botón de cierre con mayor tamaño para la "X" -->
                <Button Width="57" Height="36"
                        Margin="0,5,5,5"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CloseCommand}"
                        DockPanel.Dock="Right">
                    <Image Source="pack://application:,,,/APP.GK.WPF;component/Recursos/CloseIcon.png"
                           Width="36" Height="36"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                </Button>
            </DockPanel>

            <!-- Contenido del diálogo -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ícono (visible si Icon no es null) -->
                <Image Grid.Row="0" Grid.Column="0" Margin="10" Width="48" Height="48" Source="{Binding Icon}">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- Mensaje -->
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding Message}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="Black"
                           TextWrapping="Wrap"
                           Margin="10"/>

                <!-- Panel de botones -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="10">
                    <ItemsControl ItemsSource="{Binding Buttons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Content}" 
                                        Command="{Binding Command}"
                                        Width="100" Height="40"
                                        Margin="5"
                                        FontSize="14"
                                        Background="#C63527"
                                        Foreground="White"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="WPF.GK.BARTENDER.Vistas.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:packIcon="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WPF.GK.BARTENDER.Converters"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Convertidor para la visibilidad -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:EqualityConverter x:Key="EqualityConverter"/>

        <!-- Estilos existentes -->
        <Style x:Key="EnhancedDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#CCCCCC"/>
            <Setter Property="VerticalGridLinesBrush" Value="#CCCCCC"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ColumnWidth" Value="*"/>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#C63527"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       ToolTip="{TemplateBinding Content}"
                                       FontSize="16"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LargeDataGridTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="VistosoDataGridTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource LargeDataGridTextBlockStyle}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <!-- SearchTextBox: fondo blanco + texto rojo -->
        <Style x:Key="CustomSearchTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="Foreground" Value="#C63527"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="#C63527"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C63527"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style x:Key="CustomActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#C63527"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Estilo para el botón Actualizar en la vista sin órdenes -->
        <Style x:Key="NoOrdersUpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource CustomActionButtonStyle}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#C63527"/>
        </Style>
    </UserControl.Resources>

    <!-- ✅ OPCIÓN 2: TODA LA VISTA SCROLLEA (si la pantalla es pequeña o hay textos grandes) -->
    <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="True">

        <Grid Cursor="">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- BARRA SUPERIOR: SIEMPRE arriba cuando NO estás en "sin datos base" -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <!-- Solo se oculta en el caso real de sin datos base -->
                            <DataTrigger Binding="{Binding IsSinDatosBase}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="Órdenes de Producción"
                           Style="{DynamicResource MaterialDesignHeadline4}"
                           Foreground="White"
                           Margin="0,0,0,4"/>

                <!-- Layout pedido:
                     Izquierda: SearchTextBox | Buscar | Actualizar Parte
                     Derecha del todo: DatePicker | Limpiar fecha -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Izquierda -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>

                        <!-- Empuja a la derecha -->
                        <ColumnDefinition Width="*"/>

                        <!-- Derecha del todo -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- SearchTextBox -->
                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CustomSearchTextBoxStyle}"
                             Width="260"
                             Margin="0,0,6,0"/>

                    <!-- Buscar -->
                    <Button Content="Buscar"
                            Grid.Column="1"
                            Command="{Binding SearchCommand}"
                            Cursor="Hand"
                            Style="{StaticResource CustomActionButtonStyle}"
                            Margin="0,0,6,0"/>

                    <!-- Actualizar Parte -->
                    <Button Content="Actualizar Parte"
                            Grid.Column="2"
                            Command="{Binding RefreshCommand}"
                            Cursor="Hand"
                            Style="{StaticResource CustomActionButtonStyle}"
                            Margin="0,0,0,0"/>

                    <!-- DatePicker (derecha del todo) -->
                    <DatePicker Grid.Column="4"
                                SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"
                                Width="140"
                                Background="White"
                                BorderBrush="#C63527"
                                BorderThickness="1"
                                Margin="0,0,6,0"/>

                    <!-- Limpiar fecha -->
                    <Button Content="Limpiar fecha"
                            Grid.Column="5"
                            Command="{Binding ClearDateFilterCommand}"
                            Style="{StaticResource CustomActionButtonStyle}"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- Si no hay datos base, mensaje general y botón -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsSinDatosBase, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding EmptyMessage}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#C63527"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>
                <Button Content="Actualizar Parte"
                        Command="{Binding RefreshCommand}"
                        Cursor="Hand"
                        Style="{StaticResource NoOrdersUpdateButtonStyle}"/>
            </StackPanel>

            <!-- Si hay filtro pero no resultados: SOLO mensaje (sin duplicar barra) -->
            <StackPanel Grid.Row="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding IsSinResultadosFiltro, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding EmptyMessage}"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#C63527"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>
            </StackPanel>

            <!-- ✅ SIN VIEWBOX: así no escala raro y el ScrollViewer puede bajar hasta impresión -->
            <Grid Grid.Row="1">
                <Grid x:Name="WithOrdersGrid"
                      Visibility="{Binding HasOrders, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="#CCFFFFFF" CornerRadius="10" Padding="4"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <DataGrid x:Name="OrdersDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top"
                                  Style="{StaticResource EnhancedDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  ItemsSource="{Binding Orders}"
                                  SelectedItem="{Binding SelectedOrder}"
                                  PreviewMouseWheel="OrdersDataGrid_PreviewMouseWheel"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Seleccionar" MinWidth="120" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Width="30"
                                                      Height="30"
                                                      Command="{Binding DataContext.CheckOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}">
                                                <CheckBox.Template>
                                                    <ControlTemplate TargetType="CheckBox">
                                                        <Grid Width="30" Height="30">
                                                            <Ellipse Stroke="#C63527" StrokeThickness="2" Fill="White"/>
                                                            <Path x:Name="CheckMark"
                                                                  Data="M 8 16 L 13 21 L 22 10"
                                                                  Stroke="#C63527"
                                                                  StrokeThickness="2"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeStartLineCap="Round"
                                                                  Visibility="Collapsed"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                        <Binding />
                                                                        <Binding Path="DataContext.SelectedOrder" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </CheckBox.Template>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Nº PREVISION" Binding="{Binding NUMEROPREVISION}" MinWidth="160" Width="3*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="OP" Binding="{Binding OP}" MinWidth="150" Width="3*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="MAQUINA" Binding="{Binding MAQUINA}" MinWidth="150" Width="3*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="FECHA" Binding="{Binding FECHA, StringFormat='{}{0:yyyy-MM-dd}'}" MinWidth="140" Width="3*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="PF" Binding="{Binding PF}" MinWidth="100" Width="2*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="DESCRIPCION" Binding="{Binding DESCRIPCION}" MinWidth="180" Width="3.5*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="FECHA CADUCIDAD" Binding="{Binding FECHACADUCIDAD, StringFormat='{}{0:yyyy-MM-dd}'}" MinWidth="140" Width="3*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="LOTE" Binding="{Binding LOTE}" MinWidth="120" Width="2.2*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="CAJAS" Binding="{Binding CAJAS, StringFormat='{}{0:N0}', ConverterCulture='es-ES'}" MinWidth="100" Width="2*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="KILOS" Binding="{Binding KILOS, StringFormat='{}{0:N2}', ConverterCulture='es-ES'}" MinWidth="100" Width="2*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="EAN" Binding="{Binding EAN}" MinWidth="100" Width="2*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="DUN" Binding="{Binding DUN}" MinWidth="100" Width="2*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="UNIDADES CAJA" Binding="{Binding UNIDADESCAJA, StringFormat='{}{0:N0}', ConverterCulture='es-ES'}" MinWidth="150" Width="2*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                                <DataGridTextColumn Header="PESO NETO" Binding="{Binding PESONETO, StringFormat='{}{0:N2}', ConverterCulture='es-ES'}" MinWidth="100" Width="2*" ElementStyle="{StaticResource VistosoDataGridTextBlockStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Vista "Sin Órdenes" fuera del viewbox -->
            <Grid x:Name="NoOrdersGrid">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasOrders}" Value="False"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>

            <!-- Paginación -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="4"
                        Visibility="{Binding HasOrders, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="Anterior" Command="{Binding PrevPageCommand}" Margin="4" Cursor="Hand" Background="#C63527" Foreground="White"/>
                <TextBlock Text="Página " VerticalAlignment="Center" Margin="4" Foreground="#C63527"/>
                <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="4" Foreground="#C63527"/>
                <TextBlock Text=" de " VerticalAlignment="Center" Margin="4" Foreground="#C63527"/>
                <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="4" Foreground="#C63527"/>
                <TextBlock Text=" - Total: " VerticalAlignment="Center" Margin="4" Foreground="#C63527"/>
                <TextBlock Text="{Binding TotalRows}" VerticalAlignment="Center" Margin="4" Foreground="#C63527"/>
                <Button Content="Siguiente" Command="{Binding NextPageCommand}" Margin="4" Cursor="Hand" Background="#C63527" Foreground="White"/>
            </StackPanel>

            <!-- Panel de carga -->
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Cargando órdenes..." FontSize="16" Foreground="Gray" TextAlignment="Center" Margin="0,0,0,10"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="10" Foreground="#C63527"/>
            </StackPanel>

            <!-- Impresión -->
            <StackPanel Grid.Row="3"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Margin="8"
                        Visibility="{Binding HasOrders, Converter={StaticResource BoolToVisibilityConverter}}">

                <TextBlock Text="Seleccione impresora:"
                           Foreground="#C63527"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="4,0,4,4"
                           HorizontalAlignment="Center"/>

                <ComboBox Width="250"
                          ItemsSource="{Binding PrinterNames}"
                          SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                          Margin="4,0,4,12"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Foreground="Black"
                          VerticalAlignment="Center"
                          Background="White"
                          BorderBrush="#C63527"
                          BorderThickness="1"/>

                <Button Content="Imprimir Etiqueta"
                        Command="{Binding PrintLabelCommand}"
                        Style="{StaticResource CustomActionButtonStyle}"
                        Padding="8,4"
                        Margin="4,0"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
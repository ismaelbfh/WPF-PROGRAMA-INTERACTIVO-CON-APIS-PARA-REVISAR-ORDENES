<Window x:Class="WPF.GK.BARTENDER.CustomComponents.CopiasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Copias"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MinWidth="360"
        MinHeight="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border BorderBrush="#C63527" BorderThickness="2" CornerRadius="5" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <DockPanel Grid.Row="0" Background="#C63527" Height="50" LastChildFill="False">
                <TextBlock Text="Número de copias"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           DockPanel.Dock="Left"/>
                <Button Width="57" Height="36"
                    Margin="0,5,5,5"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CancelarCommand}"
                    DockPanel.Dock="Right">
                    <Image Source="pack://application:,,,/WPF.GK.BARTENDER;component/Recursos/CloseIcon.png"
                           Width="36" Height="36"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>   
                </Button>
            </DockPanel>

            <!-- Cuerpo -->
            <StackPanel Grid.Row="1" Margin="20">
                <TextBlock Text="¿Cuántas copias quieres mandar a imprimir?" 
                           FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Label Content="Copias:" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <!-- Control NumericUpDown -->
                    <xctk:IntegerUpDown Value="{Binding Copias, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="1"
                                        Width="80"
                                        Height="30"
                                        HorizontalContentAlignment="Center"
                                        ButtonSpinnerLocation="Right"
                                        Foreground="Black"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Aceptar" Width="100" Height="40" Margin="5"
                            Command="{Binding AceptarCommand}" Background="#C63527" Foreground="White"/>
                    <Button Content="Cancelar" Width="100" Height="40" Margin="5"
                            Command="{Binding CancelarCommand}" Background="Gray" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
